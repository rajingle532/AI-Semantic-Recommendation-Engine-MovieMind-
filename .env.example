# ═══════════════════════════════════════════════════════════════
# Movie Recommender System — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# TMDB API Key
# Get yours free at: https://www.themoviedb.org/settings/api
# Sign up → Settings → API → Request an API Key → copy "API Key (v3 auth)"
TMDB_API_KEY=your_tmdb_api_key_here

# MongoDB Connection String
# Local development: mongodb://localhost:27017/movie_recommender
# Production (Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/movie_recommender
# Get free Atlas cluster at: https://cloud.mongodb.com
MONGODB_URI=mongodb://localhost:27017/movie_recommender

# JWT Secret Key (used to sign authentication tokens)
# Generate a secure random key with:
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#   Linux/Mac:  openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend URL (for CORS — which domains can call the API)
# Local development: http://localhost:5173 (Vite default port)
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ML Model Loading Control
# Set to 'true' to bypass PyTorch/SentenceTransformers loading (useful on machines with DLL/RAM issues)
# If disabled, fallback CountVectorizer TF-IDF matrix similarity will be used instead.
DISABLE_ML_MODELS=false

