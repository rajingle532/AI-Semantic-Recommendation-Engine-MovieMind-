# MovieMind AI environment variables
# Copy this file to .env for local backend runs, or to backend/.env for Docker Compose.

# Runtime mode. Production requires strong secrets and stricter safety checks.
ENVIRONMENT=development

# TMDB API
# Get a key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_VERIFY_SSL=true

# MongoDB
# Local: mongodb://localhost:27017/movie_recommender
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/movie_recommender
MONGODB_URI=mongodb://localhost:27017/movie_recommender
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false

# JWT authentication
# Generate a secure value:
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Linux/Mac: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# CORS
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Optional AI and search integrations
GEMINI_API_KEY=your_gemini_api_key_here
SERP_API_KEY=your_serp_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional Spotify integration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Optional email integration
RESEND_API_KEY=your_resend_api_key_here

# ML model loading control
DISABLE_ML_MODELS=false
