.env
.env.local
.env.*.local

# ═══════════════════════════════════════════
# Python
# ═══════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
*.egg-info/
*.egg
dist/
build/
venv/
.venv/
env/
*.whl

# ═══════════════════════════════════════════
